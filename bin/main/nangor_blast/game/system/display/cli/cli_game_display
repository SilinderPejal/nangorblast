package nangor_blast.game.system.display.cli;

import nangor_blast.interfaces.game_event_listener;
import nangor_blast.game.system.event.game_event;

public class cli_game_display implements game_event_listener {

    @Override
    public void on_game_event(game_event event) {

        switch (event.get_type()) {

            case game_started:
                System.out.println("Game started!");
                break;

            case player_moved:
                break;

            case bomb_placed:
                System.out.println("Bomb placed!");
                break;

            case bomb_exploded:
                System.out.println("Bomb exploded!");
                break;

            case player_damaged:
                System.out.println("Player damaged!");
                break;

            case player_died:
                System.out.println("Player died!");
                break;

            case game_won:
                System.out.println("You win!");
                break;

            case game_over:
                System.out.println("Game over!");
                break;

            default:
                break;
        }
    }
}